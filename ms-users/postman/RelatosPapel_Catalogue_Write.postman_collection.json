  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login admin (guardar adminOpaqueToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('accessToken');",
                  "pm.expect(json.accessToken).to.be.a('string');",
                  "pm.environment.set('adminOpaqueToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@unir.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Crear libro (POST)",
      "item": [
        {
          "name": "POST crear libro - admin (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generamos un ISBN unico para evitar conflictos por constraint UNIQUE",
                  "const ts = new Date().getTime().toString().slice(-9);",
                  "pm.environment.set('bookIsbn', '978-TEST-' + ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('id');",
                  "pm.expect(json.title).to.eql(pm.variables.get('bookTitle'));",
                  "pm.expect(json.author).to.eql(pm.variables.get('bookAuthor'));",
                  "pm.environment.set('createdBookId', String(json.id));",
                  "pm.test('ISBN guardado en entorno', function () {",
                  "  pm.expect(pm.environment.get('createdBookId')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminOpaqueToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetMethod\": \"POST\",\n  \"queryParams\": {},\n  \"body\": {\n    \"title\": \"{{bookTitle}}\",\n    \"author\": \"{{bookAuthor}}\",\n    \"publicationDate\": \"{{bookPublicationDate}}\",\n    \"category\": \"{{bookCategory}}\",\n    \"isbn\": \"{{bookIsbn}}\",\n    \"rating\": {{bookRating}},\n    \"visible\": {{bookVisible}},\n    \"stock\": {{bookStock}},\n    \"price\": {{bookPrice}}\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ]
            }
          },
          "response": []
        },
