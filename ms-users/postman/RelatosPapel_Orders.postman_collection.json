      "name": "01 - Orders",
      "item": [
        {
          "name": "POST crear orden valida (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.expect(json).to.have.property('id');",
                  "pm.expect(json.userId).to.eql(pm.variables.get('ordersUserId'));",
                  "pm.expect(json.userEmail).to.eql(pm.variables.get('ordersUserEmail'));",
                  "pm.expect(json.bookId).to.eql(Number(pm.variables.get('visibleBookId')));",
                  "pm.expect(json.quantity).to.eql(1);",
                  "pm.environment.set('createdOrderId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{opaqueToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{ordersUserId}}\",\n  \"userEmail\": \"{{ordersUserEmail}}\",\n  \"bookId\": {{visibleBookId}},\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
