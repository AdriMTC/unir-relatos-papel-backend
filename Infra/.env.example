# ─────────────────────────────────────────────────────────────────
#  Relatos de Papel — Variables de entorno
#  Copia este archivo como .env en la carpeta Infra/ y rellena
#  los valores reales. NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────

# RabbitMQ (opcional — por defecto guest/guest en desarrollo)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT — clave secreta en Base64 (mínimo 256 bits)
# Genera una con: openssl rand -base64 64
JWT_SECRET=

# Gmail SMTP
# Genera la App Password en: Cuenta Google → Seguridad → Contraseñas de aplicación
GMAIL_USERNAME=tucuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Gemini AI
# Obtén la clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
